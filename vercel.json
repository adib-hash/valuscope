{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/summarize.js": {
      "maxDuration": 60
    },
    "api/docs.js": {
      "maxDuration": 60
    },
    "api/earnings.js": {
      "maxDuration": 60,
      "includeFiles": "data/transcript-index.json"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}\n